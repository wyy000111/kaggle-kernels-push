# Local-only configuration. Copy to .env and source it, or export manually.
KERNEL_SLUG=yongyongwuvip/kaggle-t4-llamacpp-tunnel
KAGGLE_ACCELERATOR=NvidiaTeslaT4
KAGGLE_TIMEOUT=3600
STATUS_POLL_SECONDS=180
STATUS_INTERVAL_SECONDS=15
OUTPUT_FILE_PATTERN=ollama_base_url.txt
DRY_RUN=false
ARTIFACT_DIR=artifacts

# Credentials: prefer ~/.kaggle/kaggle.json locally.
# CI stores them as GitHub Secrets; never commit them.
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# KAGGLE_API_TOKEN=
